diff --git a/tests/qtest/openme-pci-test.c b/tests/qtest/openme-pci-test.c
new file mode 100644
index 0000000..2d547d1
--- /dev/null
+++ b/tests/qtest/openme-pci-test.c
@@ -0,0 +1,241 @@
+/*
+ * QTest coverage for the OpenME project-defined fake PCI device.
+ *
+ * This test exercises only the local deterministic QEMU model.  It does not
+ * load firmware, access hardware, or claim compatibility with Intel ME.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/pci/pci.h"
+#include "libqtest.h"
+#include "libqos/pci.h"
+#include "libqos/pci-pc.h"
+
+#define OPENME_VENDOR_ID 0x1234
+#define OPENME_DEVICE_ID 0x4d45
+
+#define OPENME_REG_STATUS   0x00
+#define OPENME_REG_CONTROL  0x04
+#define OPENME_REG_VERSION  0x08
+#define OPENME_REG_EVENT    0x0c
+#define OPENME_REG_RX_LEN   0x10
+#define OPENME_REG_DOORBELL 0x14
+#define OPENME_REG_TX_LEN   0x18
+#define OPENME_REG_TX_DATA  0x400
+#define OPENME_REG_RX_DATA  0x600
+#define OPENME_REG_RX_POP   0x220
+#define OPENME_REG_PLATFORM_STATE 0x300
+#define OPENME_REG_PLATFORM_STATUS 0x304
+#define OPENME_REG_PLATFORM_STEP 0x308
+#define OPENME_REG_PLATFORM_EVENT 0x30c
+#define OPENME_REG_SPI_SIZE 0x310
+
+#define OPENME_STATUS_READY     (1 << 0)
+#define OPENME_STATUS_IRQ       (1 << 1)
+#define OPENME_STATUS_SUSPENDED (1 << 2)
+
+#define OPENME_CONTROL_RESET   (1 << 0)
+#define OPENME_CONTROL_ACK_IRQ (1 << 1)
+
+#define OPENME_CMD_START   2
+#define OPENME_CMD_DATA    7
+#define OPENME_CMD_SUSPEND 9
+
+#define OPENME_FRAME_HEADER 16
+#define OPENME_FRAME_MAGIC 0x4f4d
+
+#define OPENME_PLATFORM_RESET 0
+#define OPENME_PLATFORM_ROM 1
+#define OPENME_PLATFORM_INIT 2
+#define OPENME_PLATFORM_FAULT 8
+#define OPENME_PLATFORM_RESET_DEASSERTED (1 << 2)
+
+static QPCIDevice *openme_find_device(QPCIBus *bus)
+{
+    int devfn;
+
+    for (devfn = 0; devfn < 256; devfn++) {
+        QPCIDevice *candidate = qpci_device_find(bus, devfn);
+        uint32_t id;
+
+        if (!candidate) {
+            continue;
+        }
+
+        id = qpci_config_readl(candidate, PCI_VENDOR_ID);
+        if (id == ((OPENME_DEVICE_ID << 16) | OPENME_VENDOR_ID)) {
+            return candidate;
+        }
+        g_free(candidate);
+    }
+
+    return NULL;
+}
+
+static void test_openme_mmio_contract(void)
+{
+    QTestState *qts;
+    QPCIBus *bus;
+    QPCIDevice *dev;
+    QPCIBar bar;
+
+    qts = qtest_init("-machine q35 -nodefaults -display none "
+                     "-device openme-me,addr=01.0");
+    bus = qpci_new_pc(qts, NULL);
+    dev = openme_find_device(bus);
+    g_assert_nonnull(dev);
+
+    g_assert_cmphex(qpci_config_readl(dev, PCI_VENDOR_ID), ==,
+                    (OPENME_DEVICE_ID << 16) | OPENME_VENDOR_ID);
+
+    qpci_device_enable(dev);
+    bar = qpci_iomap(dev, 0, NULL);
+
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_VERSION), ==,
+                    0x00010001);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_STATUS), ==, 0);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_EVENT), ==, 0);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_RX_LEN), ==, 0);
+
+    /* The platform scaffold must stop cleanly when no SPI image is attached. */
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_PLATFORM_STATE), ==,
+                    OPENME_PLATFORM_RESET);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_SPI_SIZE), ==, 0);
+    qpci_io_writel(dev, bar, OPENME_REG_PLATFORM_STEP, 1);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_PLATFORM_STATE), ==,
+                    OPENME_PLATFORM_ROM);
+    qpci_io_writel(dev, bar, OPENME_REG_PLATFORM_STEP, 1);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_PLATFORM_STATE), ==,
+                    OPENME_PLATFORM_INIT);
+    qpci_io_writel(dev, bar, OPENME_REG_PLATFORM_STEP, 1);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_PLATFORM_STATE), ==,
+                    OPENME_PLATFORM_FAULT);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_PLATFORM_STATUS), ==,
+                    OPENME_PLATFORM_RESET_DEASSERTED |
+                    (1 << 0) | (1 << 1));
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_PLATFORM_EVENT), ==, 3);
+
+    qpci_io_writel(dev, bar, OPENME_REG_DOORBELL, OPENME_CMD_START);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_STATUS), ==,
+                    OPENME_STATUS_READY | OPENME_STATUS_IRQ);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_EVENT), ==, 1);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_RX_LEN), ==, 4);
+
+    qpci_io_writel(dev, bar, OPENME_REG_CONTROL, OPENME_CONTROL_ACK_IRQ);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_STATUS), ==,
+                    OPENME_STATUS_READY);
+
+    qpci_io_writel(dev, bar, OPENME_REG_TX_LEN, 5);
+    qpci_io_writeb(dev, bar, OPENME_REG_TX_DATA + 0, 'h');
+    qpci_io_writeb(dev, bar, OPENME_REG_TX_DATA + 1, 'e');
+    qpci_io_writeb(dev, bar, OPENME_REG_TX_DATA + 2, 'l');
+    qpci_io_writeb(dev, bar, OPENME_REG_TX_DATA + 3, 'l');
+    qpci_io_writeb(dev, bar, OPENME_REG_TX_DATA + 4, 'o');
+    qpci_io_writel(dev, bar, OPENME_REG_DOORBELL, OPENME_CMD_DATA);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_EVENT), ==, 2);
+
+    /* Remove START's status response before reading the echo payload. */
+    qpci_io_writel(dev, bar, OPENME_REG_RX_POP, 1);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_RX_LEN), ==, 5);
+    g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_RX_DATA + 0), ==, 'h');
+    g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_RX_DATA + 1), ==, 'e');
+    g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_RX_DATA + 2), ==, 'l');
+    g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_RX_DATA + 3), ==, 'l');
+    g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_RX_DATA + 4), ==, 'o');
+    qpci_io_writel(dev, bar, OPENME_REG_RX_POP, 1);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_RX_LEN), ==, 0);
+
+    qpci_io_writel(dev, bar, OPENME_REG_DOORBELL, OPENME_CMD_SUSPEND);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_STATUS), ==,
+                    OPENME_STATUS_READY | OPENME_STATUS_IRQ |
+                    OPENME_STATUS_SUSPENDED);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_EVENT), ==, 3);
+
+    qpci_io_writel(dev, bar, OPENME_REG_CONTROL, OPENME_CONTROL_RESET);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_STATUS), ==, 0);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_EVENT), ==, 0);
+    g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_RX_LEN), ==, 0);
+
+    /* The native adapter also accepts one complete project-defined frame. */
+    {
+        const uint8_t payload[] = "hello-openme";
+        uint8_t frame[OPENME_FRAME_HEADER + sizeof(payload) - 1];
+        size_t i;
+
+        memset(frame, 0, sizeof(frame));
+        frame[0] = OPENME_FRAME_MAGIC & 0xff;
+        frame[1] = OPENME_FRAME_MAGIC >> 8;
+        frame[2] = 1;
+        frame[4] = OPENME_CMD_DATA;
+        frame[8] = 7;
+        frame[12] = sizeof(payload) - 1;
+        memcpy(frame + OPENME_FRAME_HEADER, payload, sizeof(payload) - 1);
+
+        qpci_io_writel(dev, bar, OPENME_REG_DOORBELL, OPENME_CMD_START);
+        qpci_io_writel(dev, bar, OPENME_REG_RX_POP, 1);
+        qpci_io_writel(dev, bar, OPENME_REG_TX_LEN, sizeof(frame));
+        for (i = 0; i < sizeof(frame); i++) {
+            qpci_io_writeb(dev, bar, OPENME_REG_TX_DATA + i, frame[i]);
+        }
+        qpci_io_writel(dev, bar, OPENME_REG_DOORBELL, OPENME_CMD_DATA);
+        g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_RX_LEN), ==,
+                        sizeof(frame));
+        g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_RX_DATA + 0), ==,
+                        'M');
+        g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_RX_DATA + 1), ==,
+                        'O');
+        g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_RX_DATA + 3), ==,
+                        1);
+        g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_RX_DATA + 4), ==,
+                        OPENME_CMD_DATA);
+        g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_RX_DATA + 5), ==,
+                        0);
+        g_assert_cmpint(qpci_io_readb(dev, bar,
+                                     OPENME_REG_RX_DATA + OPENME_FRAME_HEADER),
+                        ==, 'h');
+        qpci_io_writel(dev, bar, OPENME_REG_RX_POP, 1);
+    }
+
+    /* Full 272-byte frames must not alias either buffer or control registers. */
+    {
+        uint8_t frame[OPENME_FRAME_HEADER + 256] = { 0 };
+        size_t i;
+
+        frame[0] = OPENME_FRAME_MAGIC & 0xff;
+        frame[1] = OPENME_FRAME_MAGIC >> 8;
+        frame[2] = 1;
+        frame[4] = OPENME_CMD_DATA;
+        frame[8] = 8;
+        frame[13] = 1; /* 256-byte payload, little endian. */
+        for (i = OPENME_FRAME_HEADER; i < sizeof(frame); i++) {
+            frame[i] = i - OPENME_FRAME_HEADER;
+        }
+        qpci_io_writel(dev, bar, OPENME_REG_TX_LEN, sizeof(frame));
+        for (i = 0; i < sizeof(frame); i++) {
+            qpci_io_writeb(dev, bar, OPENME_REG_TX_DATA + i, frame[i]);
+            g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_TX_DATA + i), ==, frame[i]);
+        }
+        qpci_io_writel(dev, bar, OPENME_REG_DOORBELL, OPENME_CMD_DATA);
+        frame[3] = 1; /* response flag */
+        g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_RX_LEN), ==, sizeof(frame));
+        for (i = 0; i < sizeof(frame); i++) {
+            g_assert_cmpint(qpci_io_readb(dev, bar, OPENME_REG_RX_DATA + i), ==, frame[i]);
+        }
+        g_assert_cmphex(qpci_io_readw(dev, bar, OPENME_REG_RX_DATA + sizeof(frame) - 2), ==, 0xfffe);
+        g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_RX_DATA + sizeof(frame) - 4), ==, 0xfffefdfc);
+        qpci_io_writel(dev, bar, OPENME_REG_RX_POP, 1);
+        g_assert_cmphex(qpci_io_readl(dev, bar, OPENME_REG_RX_LEN), ==, 0);
+    }
+
+    qpci_iounmap(dev, bar);
+    g_free(dev);
+    qpci_free_pc(bus);
+    qtest_quit(qts);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/openme/mmio-contract", test_openme_mmio_contract);
+    return g_test_run();
+}
